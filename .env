# --- HTTP ---
PORT=5104
NODE_ENV=development

# --- Third-party provider (Open-Meteo needs no key) ---
UPSTREAM_FORECAST=https://api.open-meteo.com/v1/forecast
UPSTREAM_GEOCODE=https://geocoding-api.open-meteo.com/v1/search

# External credentials live HERE, on the server — never in the browser,
# never in a commit. Leave empty for Open-Meteo; fill it if you switch
# to a paid provider, and it will be attached as an Authorization header.
UPSTREAM_API_KEY=

# --- Resilience ---
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_RETRIES=1
CACHE_TTL_SECONDS=600
